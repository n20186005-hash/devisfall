---
import '../styles/global.css';

/* ——— Entity: Devi's Fall Pokhara (पाताले छाँगो) ——— */
const fullName = 'Devi’s Fall Pokhara';
const localName = 'पाताले छाँगो';
const romanName = 'Patale Chhango';
const shortName = 'Devi’s Fall';
const cityName = 'Pokhara';
const stateName = 'Gandaki Province';
const countryName = 'Nepal';
const addressText = '5XQ5+HP2, H10, Pokhara, Gandaki Province 33700, Nepal';
const postalCode = '33700';
const countryCode = 'NP';
const lat = 28.1895641759;
const lng = 83.9560887771;
const mapsUrl = 'https://maps.app.goo.gl/fBtCZziA1LastCeP6';
const mapsEmbedSrc =
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6016.655445690082!2d83.9560887771393!3d28.189564175909652!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x399595134e82378f%3A0xb581716c3b162f6b!2sDevi%27s%20Fall%20Pokhara!5e1!3m2!1sne!2snp!4v1788746180053!5m2!1sne!2snp';
const phoneHref = '+9779805889741';
const phoneDisplay = '+977 980-5889741';
const rating = '4.0';
const reviewCount = '21,509';
const govtTourismUrl = 'https://trade.ntb.gov.np/tourist-destination/pokhara/';
const govtTourismName = 'Nepal Tourism Board — Pokhara';
const govtTourismUrl2 = 'https://pokharatourism.org.np/caves/';
const govtTourismName2 = 'Pokhara Tourism Council — Caves & Devi’s Fall';
const nearby1 = 'Gupteshwor Mahadev Cave';
const nearby2 = 'International Mountain Museum';
const nearby3 = 'Phewa Lake';

/* ——— Meta / TDK ——— */
const title = `${fullName} (${cityName}) — Visitor Guide & Location`;
const description =
  'Discover Devi’s Fall Pokhara (पाताले छाँगो / Patale Chhango), the iconic waterfall in Pokhara, Gandaki Province, Nepal, that travels through caves and underground tunnels. View location map, tickets & hours, and nearby Gupteshwor Mahadev Cave.';
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogImage = Astro.site ? new URL('/og-card.jpg', Astro.site).toString() : '/og-card.jpg';
const heroImage = Astro.site ? new URL('/images/devis-fall-monsoon.jpg', Astro.site).toString() : '/images/devis-fall-monsoon.jpg';

/* ——— Photos (local files, attributed per license) ——— */
const photos = [
  {
    src: '/images/devis-fall-monsoon.jpg',
    alt: 'Devi’s Fall Pokhara (पाताले छाँगो) in full flow during the monsoon',
    caption: 'वर्षायाममा पानीको बहाव सबैभन्दा नाटकीय देखिन्छ।',
    credit: 'Saroj Pandey · CC BY-SA 3.0',
    source: 'https://commons.wikimedia.org/wiki/File:Davis_falls_in_full_flow_during_rainy_season,_Pokhara.jpg',
  },
  {
    src: '/images/devis-fall-gorge.jpg',
    alt: 'Devi’s Fall Pokhara (पाताले छाँगो) streaming through a green rock gorge',
    caption: 'सुख्खा समयमा चट्टानका तह र साँघुरो जलमार्ग अझ स्पष्ट देखिन्छन्।',
    credit: 'Harsh Mahaseth · CC BY-SA 4.0',
    source: 'https://commons.wikimedia.org/wiki/File:Davis_Falls.jpg',
  },
  {
    src: '/images/devis-fall-rock-channel.jpg',
    alt: 'Water dropping into the narrow rock channel at Devi’s Fall Pokhara',
    caption: 'पानी सतहबाट साँघुरो खोंचतर्फ खस्दै भूमिगत मार्गमा पस्छ।',
    credit: 'Nabin845 · CC BY-SA 4.0',
    source: 'https://commons.wikimedia.org/wiki/File:David%27s_fall_Pokhara.jpg',
  },
  {
    src: '/images/devis-fall-from-gupteshwor-cave.jpg',
    alt: 'Devi’s Fall seen from inside Gupteshwor Mahadev Cave',
    caption: 'गुप्तेश्वर महादेव गुफाको तल्लो भागबाट जलधाराको अर्को रूप देख्न सकिन्छ।',
    credit: 'Rajivkilanashrestha · CC BY-SA 3.0',
    source: 'https://commons.wikimedia.org/wiki/File:Devi%27s_Fall_from_Gupteshwor_Cave.JPG',
  },
];

const faqs = [
  {
    q: 'Where is Devi’s Fall Pokhara (पाताले छाँगो) located?',
    a: 'Devi’s Fall Pokhara (पाताले छाँगो / Patale Chhango) is located on H10 road in Chhorepatan, Pokhara, Gandaki Province 33700, Nepal (plus code 5XQ5+HP2), beside Gupteshwor Mahadev Cave and about 10–15 minutes by taxi from Lakeside.',
  },
  {
    q: 'Is there an entrance fee for Devi’s Fall Pokhara?',
    a: 'Yes, Devi’s Fall Pokhara is ticketed. The municipal rate structure lists NPR 30 for Nepali students, NPR 50 for Nepali citizens and NPR 150 for foreign visitors; please confirm current rates at the ticket counter.',
  },
  {
    q: 'पाताले छाँगो हेर्न कति समय छुट्याउने?',
    a: 'झरना मात्र सहज गतिमा हेर्न करिब ३०–४५ मिनेट पर्याप्त हुन्छ। गुप्तेश्वर महादेव गुफा पनि जोड्दा कम्तीमा १.५–२ घण्टा राख्नु राम्रो हुन्छ।',
  },
  {
    q: 'सबैभन्दा राम्रो समयमा कहिले जाने?',
    a: 'वर्षा र वर्षापछिको समयमा बहाव बलियो हुन्छ। वर्षामा दृश्य प्रभावशाली भए पनि रेलिङ, ढुंगा र गुफा आसपास चिप्लो हुन सक्छ; सुरक्षित जुत्ता उपयोगी हुन्छ।',
  },
  {
    q: 'प्रवेश शुल्क कति छ?',
    a: 'नगरबाट सार्वजनिक गरिएको शुल्क संरचनाअनुसार नेपाली विद्यार्थी रु ३०, नेपाली नागरिक रु ५० र विदेशी पर्यटक रु १५० राखिएको छ। शुल्क परिवर्तन हुन सक्ने भएकाले टिकट काउन्टरमा हालको दर पुष्टि गर्नुहोस्।',
  },
  {
    q: 'गुप्तेश्वर महादेव गुफा यही टिकटमा पर्छ?',
    a: 'पर्दैन। गुफा सडकपारि छुट्टै आकर्षण हो र यसको प्रवेश व्यवस्था अलग हुन्छ। दुवैलाई एउटै यात्रामा मिलाउन सजिलो छ।',
  },
  {
    q: 'बालबालिका वा ज्येष्ठ नागरिकका लागि उपयुक्त छ?',
    a: 'मुख्य अवलोकन क्षेत्र धेरै कठिन होइन, तर भीड, भिजेको सतह र केही असमान बाटो हुन सक्छ। रेलिङ नछोड्नुहोस् र वर्षामा विशेष सावधानी अपनाउनुहोस्।',
  },
  {
    q: 'फोटो खिच्न कहाँ राम्रो?',
    a: 'मुख्य रेलिङको तिरछो कोणबाट खोंच र पानीको गहिराइ एउटै फ्रेममा आउँछ। वर्षामा पानीको फोहरा धेरै हुने भएकाले लेन्स कपडा उपयोगी हुन्छ। गुफाभित्र धार्मिक क्षेत्रको फोटो नियम स्थलमै हेर्नुहोस्।',
  },
  {
    q: 'लेकसाइडबाट कसरी जाने?',
    a: 'ट्याक्सी वा राइड सबैभन्दा सीधा विकल्प हो र ट्राफिकअनुसार करिब १०–१५ मिनेट लाग्न सक्छ। स्थानीय बसमा चोरेपाटन/सिद्धार्थ राजमार्गतर्फ जाने र झरना नजिक झर्ने विकल्प पनि छ।',
  },
];

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  '@id': 'https://devisfall.com/#attraction',
  name: fullName,
  alternateName: [shortName, localName, romanName, `${cityName} ${fullName}`],
  description,
  telephone: phoneHref,
  isAccessibleForFree: false,
  hasMap: mapsUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '5XQ5+HP2, H10',
    addressLocality: cityName,
    addressRegion: stateName,
    postalCode,
    addressCountry: countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: lat,
    longitude: lng,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '06:00',
      closes: '18:00',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: rating,
    bestRating: '5',
    reviewCount: reviewCount.replace(',', ''),
  },
  priceRange: 'रु ३०–१५०',
  sameAs: [mapsUrl, govtTourismUrl, govtTourismUrl2],
  ...(canonicalURL ? { url: canonicalURL, image: [heroImage, ogImage] } : {}),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: countryName },
    { '@type': 'ListItem', position: 2, name: stateName },
    { '@type': 'ListItem', position: 3, name: cityName },
    { '@type': 'ListItem', position: 4, name: fullName },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---
<!doctype html>
<html lang="ne">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071b18" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={fullName} />
    <meta property="og:locale" content="ne_NP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${fullName} in ${cityName}, ${countryName}`} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${fullName} in ${cityName}, ${countryName}`} />

    <script type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </head>
  <body>
    <header class="fixed inset-x-0 top-0 z-50 border-b border-white/8 glass">
      <div class="shell flex h-20 items-center justify-between gap-5">
        <a href="#top" class="focus-ring flex items-center" aria-label="पाताले छाँगो मुख्य भाग">
          <img src="/logo.svg" alt="पाताले छाँगो" width="246" height="68" class="h-14 w-auto" />
        </a>
        <nav class="hidden items-center gap-7 text-sm text-foam/75 md:flex" aria-label="मुख्य नेभिगेसन">
          <a class="hover:text-water" href="#experience">झरना</a>
          <a class="hover:text-water" href="#plan">यात्रा योजना</a>
          <a class="hover:text-water" href="#nearby">वरिपरि</a>
          <a class="hover:text-water" href="#map">नक्सा</a>
          <a class="hover:text-water" href="#faq">प्रश्नोत्तर</a>
        </nav>
        <a href="https://maps.app.goo.gl/fBtCZziA1LastCeP6" class="focus-ring rounded-full border border-water/35 bg-water/10 px-4 py-2 text-sm font-bold text-water hover:bg-water/15" target="_blank" rel="noopener noreferrer">दिशा खोल्नुहोस् ↗</a>
      </div>
    </header>

    <main id="top">
      <section class="relative min-h-[810px] overflow-hidden pt-20">
        <div class="hero-media absolute inset-0 top-20">
          <img src={photos[0].src} alt={`${fullName} — Main view in ${cityName}, ${countryName}`} width="1200" height="1800" loading="eager" decoding="async" />
        </div>
        <div class="shell relative z-10 flex min-h-[730px] items-end pb-16 pt-28 lg:items-center lg:pb-0">
          <div class="max-w-3xl">
            <p class="text-xs font-bold uppercase tracking-[.2em] text-water/90">Nepal → Gandaki Province → Pokhara → {fullName}</p>
            <p class="mt-5 text-sm font-bold uppercase tracking-[.22em] text-rock/70">{fullName} · {localName} · {romanName} · Visitor Guide</p>
            <span class="kicker">पोखरा · चोरेपाटन</span>
            <h1 class="mt-3 text-[clamp(3.7rem,10vw,8.6rem)] font-black leading-[.92] tracking-[-.06em] text-foam">पाताले<br /><span class="text-water">छाँगो</span></h1>
            <p class="mt-7 max-w-2xl text-lg leading-8 text-foam/78 md:text-xl">पार्दी खोलाको पानी चट्टानको गहिरो खोंचमा झर्छ, आँखाअघि हराउँछ र भूमिगत मार्ग समात्छ—पोखराको सबैभन्दा अनौठो जल–भू-दृश्यमध्ये एक।</p>
            <p class="mt-4 max-w-2xl text-sm font-medium text-foam/58">{fullName} ({localName} / {romanName}) — {cityName}’s iconic scenic waterfall in {stateName}, {countryName}, known for travelling through caves and underground tunnels.</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <span class="pill">◷ सामान्य समय ०६:००–१८:००</span>
              <span class="pill">⌛ ३०–४५ मिनेट</span>
              <span class="pill">☂ वर्षा/वर्षापछि प्रभावशाली</span>
              <span class="pill">★ सूचीबद्ध मूल्याङ्कन ४.०/५</span>
            </div>
          </div>
        </div>
        <div class="absolute bottom-0 left-0 right-0 z-10 h-20 bg-gradient-to-t from-cave to-transparent"></div>
      </section>

      <section id="about" class="border-b border-white/8 py-14 md:py-16">
        <div class="shell grid gap-8 md:grid-cols-[.9fr_1.1fr] md:items-center">
          <div>
            <span class="kicker">ENGLISH · VISITOR GUIDE</span>
            <h2 class="section-title mb-0">About {fullName}<br /><span class="text-water">({localName} / {romanName})</span></h2>
          </div>
          <div class="space-y-4 text-[15px] leading-7 text-foam/70">
            <p>Welcome to <strong class="text-foam">{fullName}</strong>, widely recognized as the central <strong class="text-foam">{romanName} ({localName})</strong>. Located in <strong class="text-foam">{cityName}, {stateName}, {countryName}</strong>, this destination serves as one of the city’s most visited natural landmarks for travellers exploring the Phewa Lake region.</p>
            <p>When visiting <strong class="text-foam">{fullName}</strong>, visitors can easily explore surrounding landmarks and points of interest, including <strong class="text-foam">{nearby1}</strong> and <strong class="text-foam">{nearby2}</strong>.</p>
            <p class="text-sm text-foam/50">NAP · {fullName} — {addressText} — {phoneDisplay}</p>
          </div>
        </div>
      </section>

      <section id="experience" class="py-24 md:py-32">
        <div class="shell grid gap-12 lg:grid-cols-[.85fr_1.15fr] lg:items-center">
          <div>
            <span class="kicker">किन फरक छ?</span>
            <h2 class="section-title">झरना तल होइन,<br /><span class="text-water">जमिनभित्र जान्छ।</span></h2>
            <p class="section-copy">फेवा ताल क्षेत्रबाट निस्कने जलप्रवाह पार्दी खोलातर्फ आउँदै यहाँ साँघुरो चट्टानी खोंचमा प्रवेश गर्छ। सतहमा देखिने झरना केही क्षणमै भूमिगत जलमार्गमा हराउँछ; यही भौगोलिक रूपले पाताले छाँगोलाई साधारण “दृश्य झरना” भन्दा फरक बनाउँछ।</p>
            <div class="mt-8 grid gap-4 sm:grid-cols-2">
              <div class="card p-5"><div class="icon-bubble">≈</div><h3 class="mt-4 font-bold">चट्टानी तह</h3><p class="mt-2 text-sm text-foam/65">जलकटावले काटिएका तह, साँघुरो खोंच र गहिरो प्वाल मुख्य दृश्य तत्व हुन्।</p></div>
              <div class="card p-5"><div class="icon-bubble">↓</div><h3 class="mt-4 font-bold">लुकेको जलमार्ग</h3><p class="mt-2 text-sm text-foam/65">पानी सतहबाट हराएर भूमिगत सुरुङ-जस्तो प्राकृतिक मार्ग हुँदै अघि बढ्छ।</p></div>
            </div>
          </div>
          <div class="flow-diagram card strata" aria-label="पानी सतहबाट भूमिगत मार्गमा जाने सांकेतिक रेखाचित्र">
            <div class="earth"></div><div class="waterway"></div><div class="shaft"></div><div class="cave"></div>
            <div class="absolute left-[7%] top-[9%] rounded-full bg-cave/85 px-3 py-2 text-xs font-bold text-water">पार्दी खोलाको जलप्रवाह</div>
            <div class="absolute right-[5%] top-[29%] max-w-36 text-right text-xs font-bold text-foam/70">साँघुरो खोंचबाट तीव्र झराइ</div>
            <div class="absolute bottom-[5%] right-[8%] text-xs font-bold text-rock/80">भूमिगत प्राकृतिक मार्ग</div>
          </div>
        </div>
      </section>

      <section id="plan" class="border-y border-white/8 bg-black/10 py-24 md:py-32">
        <div class="shell">
          <div class="max-w-3xl">
            <span class="kicker">यात्रा योजना</span>
            <h2 class="section-title">एक छोटो रोकाइलाई<br />पूरै अनुभव बनाउने तरिका</h2>
          </div>
          <div class="mt-12 grid gap-5 lg:grid-cols-3">
            <article class="card water-line p-7">
              <p class="text-xs font-bold tracking-[.15em] text-water">टिकट / शुल्क</p>
              <h3 class="mt-3 text-2xl font-black">रु ३०–१५०</h3>
              <ul class="mt-5 space-y-2 text-sm text-foam/70">
                <li>नेपाली विद्यार्थी: रु ३०</li><li>नेपाली नागरिक: रु ५०</li><li>विदेशी पर्यटक: रु १५०</li>
              </ul>
              <p class="mt-5 text-xs leading-5 text-rock/65">नगरबाट सार्वजनिक गरिएको शुल्क संरचना। काउन्टरमा हालको दर र छुटको प्रमाण आवश्यकताबारे पुष्टि गर्नुहोस्।</p>
            </article>
            <article class="card water-line p-7">
              <p class="text-xs font-bold tracking-[.15em] text-water">राम्रो समय / बसाइ</p>
